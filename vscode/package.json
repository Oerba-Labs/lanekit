{
  "name": "lanekit",
  "displayName": "LaneKit",
  "description": "Every lane of every repository as a smartlog you act on inside the editor: open a commit's or a lane's changes, gate, land and sweep.",
  "publisher": "lanekit",
  "version": "0.15.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Oerba-Labs/lanekit.git"
  },
  "icon": "lanekit.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "LaneKit runs the repository's own lane and gate commands."
    }
  },
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:lanekit.lanes",
    "onView:lanekit.sidebar"
  ],
  "contributes": {
    "commands": [
      {
        "command": "lanekit.reveal",
        "title": "Show LaneKit",
        "category": "LaneKit",
        "icon": "$(list-tree)"
      },
      {
        "command": "lanekit.show",
        "title": "Show in an Editor Tab",
        "category": "LaneKit",
        "icon": "$(link-external)"
      },
      {
        "command": "lanekit.showRepository",
        "title": "Show a Repository in a Tab of Its Own\u2026",
        "category": "LaneKit",
        "icon": "$(link-external)"
      },
      {
        "command": "lanekit.newLane",
        "title": "New Lane\u2026",
        "category": "LaneKit",
        "icon": "$(add)"
      },
      {
        "command": "lanekit.laneMenu",
        "title": "This Lane\u2026",
        "category": "LaneKit"
      },
      {
        "command": "lanekit.newLaneHere",
        "title": "New Lane from Here\u2026",
        "category": "LaneKit"
      },
      {
        "command": "lanekit.rebase",
        "title": "Rebase This Lane\u2026",
        "category": "LaneKit"
      },
      {
        "command": "lanekit.push",
        "title": "Push This Lane",
        "category": "LaneKit"
      },
      {
        "command": "lanekit.gate",
        "title": "Gate This Lane\u2026",
        "category": "LaneKit"
      },
      {
        "command": "lanekit.land",
        "title": "Land This Lane\u2026",
        "category": "LaneKit"
      },
      {
        "command": "lanekit.changes",
        "title": "Show This Lane's Changes",
        "category": "LaneKit"
      },
      {
        "command": "lanekit.startAgent",
        "title": "Start an Agent in This Lane\u2026",
        "category": "LaneKit",
        "icon": "$(sparkle)"
      },
      {
        "command": "lanekit.agents",
        "title": "Show the Agents at Work\u2026",
        "category": "LaneKit",
        "icon": "$(sparkle)"
      },
      {
        "command": "lanekit.reportAgents",
        "title": "Have This Machine's Agents Report to LaneKit",
        "category": "LaneKit"
      },
      {
        "command": "lanekit.goto",
        "title": "Go to a Lane\u2026",
        "category": "LaneKit",
        "icon": "$(arrow-right)"
      },
      {
        "command": "lanekit.openLane",
        "title": "Open a Lane in a New Window\u2026",
        "category": "LaneKit"
      },
      {
        "command": "lanekit.refresh",
        "title": "Refresh",
        "category": "LaneKit",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lanekit",
          "title": "LaneKit",
          "icon": "lanekit.svg"
        }
      ]
    },
    "views": {
      "lanekit": [
        {
          "type": "webview",
          "id": "lanekit.sidebar",
          "name": "LaneKit"
        }
      ]
    },
    "menus": {
      "scm/title": [
        {
          "command": "lanekit.reveal",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "lanekit.newLane",
          "when": "view == lanekit.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "lanekit.refresh",
          "when": "view == lanekit.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "lanekit.show",
          "when": "view == lanekit.sidebar",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "LaneKit",
      "properties": {
        "lanekit.path": {
          "type": "string",
          "default": "",
          "description": "Where lanekit is checked out. Empty: $LANEKIT, then /opt/lanekit, then ~/.lanekit, as the project's shim looks."
        },
        "lanekit.folders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Folders to find repositories with lanes in, besides the folders open in this window."
        },
        "lanekit.opensIn": {
          "type": "string",
          "enum": [
            "tab",
            "sideBar"
          ],
          "enumDescriptions": [
            "An editor tab, with the whole page's room: the LaneKit icon opens it and closes the side bar again.",
            "The side bar, beside whatever is open in the editor."
          ],
          "default": "tab",
          "description": "Where LaneKit opens: from its icon in the activity bar, from the status bar's lane menu, and from a notification's Show."
        },
        "lanekit.reportAgents": {
          "type": "string",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Ask once, the first time a repository with lanes is open on this machine.",
            "Add LaneKit's hook to Claude Code's settings and its plugin to OpenCode's without asking, and keep them up to date.",
            "Never add them, and never ask."
          ],
          "default": "ask",
          "scope": "machine",
          "description": "Whether this machine's agents say which lane they work in and what they are doing, through LaneKit's hook in ~/.claude/settings.json and its plugin in ~/.config/opencode/plugins/."
        },
        "lanekit.gateOnCommit": {
          "type": "boolean",
          "default": false,
          "description": "Gate a lane by itself when a commit lands in it and nothing is uncommitted. The gate rebases the lane onto the integration branch first, as it always does."
        }
      }
    }
  }
}
